# Copy this file to ".env" (same folder) and fill it in. Never share or upload the .env file.

# --- Paymob (online card payments) -------------------------------------------
# Paymob dashboard -> Settings -> Account Info (API keys + HMAC) and Developers -> Payment Integrations (integration id).
# Use the TEST keys + a TEST card integration first.
PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
# While any of the four is empty the site uses a fake "test payment" page, so you can try the flow without keys.

# Vodafone Cash through Paymob (automatic): ask your Paymob account manager to enable "Mobile Wallet", then paste that integration's id.
# With this set, "Vodafone Cash" sends the customer to Paymob and the order is confirmed by the same signed webhook as cards.
PAYMOB_WALLET_INTEGRATION_ID=

# --- Manual payments (customer transfers money, you confirm it at /admin.html) -----------------------------
# Leave a method empty to hide it. If PAYMOB_WALLET_INTEGRATION_ID is set, VODAFONE_CASH_NUMBER is not used.
VODAFONE_CASH_NUMBER=
VODAFONE_CASH_NAME=
INSTAPAY_ADDRESS=
INSTAPAY_NAME=
ADMIN_TOKEN=
MANUAL_HOLD_MINUTES=180

# --- Google sign-in -----------------------------------------------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials -> Create OAuth client ID (Web application).
# Authorised redirect URI: <PUBLIC_URL>/api/auth/google/callback   (local test: http://localhost:8000/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Shop ---------------------------------------------------------------------
CURRENCY=EGP
SHIPPING_FEE=0
ENABLE_COD=1

# --- Going live ---------------------------------------------------------------
# PUBLIC_URL=https://your-domain.com     (Paymob needs a public address for its webhook; use ngrok while testing)
# HOST=0.0.0.0                           (listen on the network; default is this PC only)
# COOKIE_SECURE=1                        (turn on once the site is served over https)
